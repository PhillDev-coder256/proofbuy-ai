# ProofBuy AI — Environment Variables
# Copy this file to backend/.env and fill in your values.
# Never commit real credentials to version control.
# All services have mock modes and work without API keys.

APP_ENV=development

# Database (default: SQLite for local dev; use PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./proofbuy_dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/proofbuy

# Channel3 product search API — https://docs.trychannel3.com
# Leave empty to use mock mode (3 hardcoded products)
CHANNEL3_API_KEY=

# AI provider — Groq (OpenAI-compatible API)
# Leave empty to use mock mode (hardcoded requirements extraction)
AI_PROVIDER=groq
AI_PROVIDER_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# PayPal Orders v2 — https://developer.paypal.com
# Leave empty to use mock mode (no real PayPal calls)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
